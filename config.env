# Configuração central do provisionamento AlertaSP.
# Todos os scripts leem este arquivo. Edite aqui antes de rodar ./provision.sh

# --- Infraestrutura ---
VM_HOSTNAME="alertasp"
DOMAIN="alertasp.local"
TIMEZONE="America/Sao_Paulo"
NET_IFACE="enp0s8"              # placa "host-only" do VirtualBox (ver: ip -br link)
NET_IP="192.168.56.10"
NET_PREFIX="24"
DNS_SERVERS="8.8.8.8 1.1.1.1"

# --- Aplicação (API SOA: Java 21 + Maven + Spring Boot) ---
APP_REPO=""                      # URL git da API, ex: https://github.com/grupo/alertasp-api.git
APP_BRANCH="main"
APP_SUBDIR=""                    # pasta do pom.xml dentro do repo ("" = raiz)
JAVA_OPTS="-Xms256m -Xmx512m"
HEALTH_PATH="/v3/api-docs"       # endpoint do springdoc usado como health check

# --- Banco (PostgreSQL) ---
# A senha é gerada automaticamente e guardada em /etc/alertasp/alertasp.env
DB_NAME="alertasp"
DB_USER="alertasp"

# --- Monitoramento ---
CPU_LIMIT=80                     # % para gerar ALERTA
MEM_LIMIT=85
DISK_LIMIT=85
MONITOR_INTERVAL=10              # segundos entre coletas
